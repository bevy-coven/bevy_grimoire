#!/usr/bin/env bash
# The push gate for loop worker clones (`git config core.hooksPath tools/loop/hooks`). Owner, 2026-10-29.
# A push to main runs the deterministic gate on the commit being pushed and is refused when it fails.
# Measured 2026-10-29: passes that skipped `cargo test --workspace` pushed tests failing 165 of 200 runs.
#
# Clean-merge fast path (owner's session, 2026-10-29). With six workers gating at once, a push refused
# for being behind used to merge main and rerun the whole 40-minute gate, and was often refused again.
# A commit that passes the full gate is recorded in `<git-dir>/gate-passed`. A merge commit whose one
# parent is recorded, whose other parent is already on the remote's main (it passed its own pusher's
# gate), and whose tree is exactly what `git merge-tree` makes of the two (no conflict, no hand edit)
# runs clippy over every target, which type-checks every crate and test, instead of the test run.
set -u
cargo="${LOOP_GATE_CARGO:-cargo}"
zero=0000000000000000000000000000000000000000
target="" remote="" code=0
# The pushed refs arrive on stdin once; `git lfs pre-push` below needs them too.
refs=$(cat)
while read -r _local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  [ "$local_sha" = "$zero" ] && continue
  target="$local_sha" remote="$remote_sha"
  # **A push origin will refuse costs no gate** (owner's session, 2026-10-30). When main has moved past
  # this clone (origin's tip is unknown here, or not an ancestor of the push), the push is refused as
  # non-fast-forward after the hook anyway, so running the 30-40 minute gate first only loses the race
  # again: bmb's w2 lost its log line to this loop for hours (30 commits ahead, a gate timed out at
  # 1800 s, main moved meanwhile). Refuse at once, so the worker merges and pushes again while it is fresh.
  if [ "$remote_sha" != "$zero" ] && { ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null ||
       ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; }; then
    echo "pre-push gate: REFUSED without running the gate: origin's main (${remote_sha:0:9}) is not in this push, so origin would refuse it as non-fast-forward. Run git pull --no-rebase origin main, then push again at once." >&2
    exit 1
  fi
  if [ "$remote_sha" = "$zero" ]; then
    code=1
  elif git diff --name-only "$remote_sha" "$local_sha" | grep -qvE '^docs/|\.md$|\.(gif|mp4|png|jpg|webp)$'; then
    code=1
  fi
done <<<"$refs"
[ -n "$target" ] || exit 0
# Every gate run leaves one line per step in `<git-dir>/gate.log` (time, commit, step, seconds), so how long
# the gate costs each worker is measured, not guessed: pass logs hold only the agent's final message.
log="$(git rev-parse --git-dir)/gate.log"
note() { printf '%s %s %s\n' "$(date +%FT%T)" "${target:0:9}" "$*" >> "$log"; }
refuse() { note "REFUSED $*"; echo "pre-push gate: REFUSED: $*" >&2; echo "pre-push gate: fix it, or log the item as blocked; never --no-verify." >&2; exit 1; }
timed() { local name=$1 t0 rc; shift; t0=$(date +%s); "$@"; rc=$?; note "$name rc=$rc $(( $(date +%s) - t0 ))s"; return $rc; }
[ "$(git rev-parse HEAD)" = "$target" ] || refuse "push the checked-out commit (HEAD $(git rev-parse --short HEAD), pushing ${target:0:9})"
[ -z "$(git status --porcelain -- crates Cargo.toml Cargo.lock tools)" ] || refuse "uncommitted changes under crates/, Cargo.*, tools/ would be tested instead of the commit; commit or stash them"
# **A clip's file reaches GitHub, not only its pointer** (owner, 2026-11-01). `core.hooksPath` replaces git-lfs's own
# `pre-push`, so a push from this clone sent a clip's pointer to main and kept the file: eight changelog media files were
# missing on the server (GH008, and a fresh checkout failing "smudge filter lfs failed"). Upload the pushed commits' LFS
# objects first, with the refs this hook was given, and refuse the push when that fails.
printf '%s\n' "$refs" | git lfs pre-push "$@" >&2 || refuse "git lfs pre-push failed: the commit's LFS objects (a changelog clip) are not on the server, so the push would leave their pointers without files. Is git-lfs installed (git lfs install)?"
# A merge resolved by hand can leave its conflict markers behind (a10b342 removed six from CHANGELOG.md and ops.rs, 2026-10-29).
markers=$(git grep -nE '^(<<<<<<<|>>>>>>>) ' "$target" -- . ':!*.patch' 2>/dev/null | head -5)
[ -z "$markers" ] || refuse "conflict markers in the commit: ${markers//$'\n'/; }"
python3 tools/loop/backlog.py check >/dev/null || refuse "python3 tools/loop/backlog.py check failed"
python3 tools/changelog/changelog.py check >/dev/null || refuse "python3 tools/changelog/changelog.py check failed"
# The editor's integration tests are modules of one binary (`crates/bevy_cauldron/tests/all.rs`, `autotests = false`):
# a file missing from `all.rs` is never compiled, so its tests never run, and clippy alone (the clean-merge path) cannot see it.
all=crates/bevy_cauldron/tests/all.rs
if [ -f "$all" ]; then
  for f in crates/bevy_cauldron/tests/*.rs; do
    s=$(basename "$f" .rs)
    [ "$s" = all ] || grep -qx "mod $s;" "$all" || refuse "$f is not a module of the editor's test binary: add \`mod $s;\` to $all (and \`use crate::fixtures;\`, not \`mod fixtures;\`, in the file)"
  done
fi
if [ "$code" = 0 ]; then echo "pre-push gate: docs and media only; backlog and changelog checks passed" >&2; exit 0; fi
passed="$(git rev-parse --git-dir)/gate-passed"
gated() { [ -f "$passed" ] && grep -qx "$1" "$passed"; }
clean_merge_of_main() {
  local parents p1 p2 tree
  parents=$(git rev-list --parents -n 1 "$target")
  set -- $parents
  [ $# -eq 3 ] || return 1
  p1=$2 p2=$3
  { gated "$p1" && git merge-base --is-ancestor "$p2" "$remote"; } ||
    { gated "$p2" && git merge-base --is-ancestor "$p1" "$remote"; } || return 1
  tree=$(git merge-tree --write-tree "$p1" "$p2" 2>/dev/null) || return 1
  [ "$tree" = "$(git rev-parse "$target^{tree}")" ]
}
# Git opens the connection before this hook runs, and GitHub drops it while a 30-minute gate runs
# ("Connection to github.com closed by remote host", bevy_emerge_loop, 2026-10-29): the gate passed,
# the push did not. Pushing the same commit again needs no second gate.
if gated "$target"; then note "already gated, pushing again"; echo "pre-push gate: ${target:0:9} already passed the gate in this clone; pushing it again" >&2; exit 0; fi
start=$(date +%s)
if clean_merge_of_main; then
  echo "pre-push gate: ${target:0:9} is a clean merge of main into a commit that passed the gate; clippy over every target only" >&2
  timed clippy-merge $cargo clippy --workspace --all-targets -q -- -D warnings || refuse "cargo clippy --workspace --all-targets -- -D warnings failed on the merge"
else
  echo "pre-push gate: clippy and cargo test --workspace on ${target:0:9}; this takes minutes, so give git push a timeout of 1800 s or more" >&2
  timed clippy $cargo clippy --workspace --all-targets -q -- -D warnings || refuse "cargo clippy --workspace --all-targets -- -D warnings failed"
  timed test $cargo test --workspace -q --no-fail-fast || refuse "cargo test --workspace failed (the failing tests are named above)"
fi
echo "$target" >> "$passed"
note "passed $(( $(date +%s) - start ))s"
echo "pre-push gate: passed in $(( $(date +%s) - start ))s" >&2
