<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  THE GRIMOIRE WIGGUM LOOP ON big_mac (Apple Silicon).

  Why launchd and not a shell: a `setsid nohup` loop dies with the login session and never restarts
  after a reboot or a crash. launchd user agents keep running after logout (as long as the user is
  logged in, which on this machine it is — `who` shows a console session) and relaunch per `KeepAlive`.

  Install:
    cp com.ladvien.wiggum-emerge.plist ~/Library/LaunchAgents/
    launchctl bootout  gui/$(id -u)/com.ladvien.wiggum-emerge 2>/dev/null
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.ladvien.wiggum-emerge.plist

  Read:
    launchctl print gui/$(id -u)/com.ladvien.wiggum-emerge | head -40
    tail -f ~/.local/state/wiggum/bevy_emerge_loop/driver.log

  Drain (lets the pass in flight FINISH, then exits; cuts nothing; launchd does not restart a clean exit, so
  start it again with `launchctl start com.ladvien.wiggum-emerge`):
    WIGGUM_REPO=$HOME/bevy_emerge_loop ~/bevy_emerge_loop/tools/loop/wiggum.sh drain --wait

  Stop (ends the pass in flight within seconds, then exits; the driver snapshots its tree):
    WIGGUM_REPO=$HOME/bevy_emerge_loop ~/bevy_emerge_loop/tools/loop/wiggum.sh stop
    launchctl bootout gui/$(id -u)/com.ladvien.wiggum-emerge
-->
<!--
  `USER` is a placeholder: the install step rewrites every `/Users/USER` to the real account name
  (`sed -i '' "s|/Users/USER|$HOME|g"`), because launchd does not expand `$HOME` or `~` in
  `ProgramArguments`, `WorkingDirectory`, `StandardOutPath` or `EnvironmentVariables`.
  SUBSTITUTION
-->
<plist version="1.0">
<dict>
  <!-- `KeepAlive.SuccessfulExit=false` + `Crashed=true` rather than plain KeepAlive: the driver exits 0
       when its stop file is honoured, and a plain KeepAlive would immediately start it again, making
       `stop` impossible to observe. -->
  <key>Label</key>
  <string>com.ladvien.wiggum-emerge</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/USER/bevy_emerge_loop/tools/loop/wiggum.sh</string>
    <string>__driver</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/USER/bevy_emerge_loop</string>

  <!-- **`RunAtLoad` false on purpose.** Installing an agent must not start a pass while a human is
       setting things up; `launchctl kickstart -k` is how it is started deliberately. After a reboot
       launchd still loads the job and `KeepAlive` starts it. -->
  <key>RunAtLoad</key>
  <false/>

  <key>KeepAlive</key>
  <dict>
    <key>Crashed</key>
    <true/>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <!-- A pass that crashes instantly, three times in ten minutes, is a broken checkout: back off. -->
  <key>ThrottleInterval</key>
  <integer>600</integer>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd's PATH is minimal and does not include the toolchain or omp. Measured on this family:
         without this the pass dies rc=127 while the job reports it is running. -->
    <key>PATH</key>
    <string>/Users/USER/.local/bin:/Users/USER/.cargo/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/USER</string>
    <key>WIGGUM_REPO</key>
    <string>/Users/USER/bevy_emerge_loop</string>
    <key>WIGGUM_COMMAND</key>
    <string>build-loop</string>
    <key>WIGGUM_MODEL</key>
    <string>claude-sonnet-5-5</string>
    <key>WIGGUM_SLEEP</key>
    <string>60</string>
    <!-- **Backstop, not a schedule.** The driver exits 0 at the cap and `KeepAlive` is `Crashed`
         only, so a clean exit is not restarted — a small number would silently end the loop. 400
         passes is weeks; the intent is that a human stops it. Absent, the driver runs forever. -->
    <key>WIGGUM_MAX</key>
    <string>400</string>
    <key>WIGGUM_THINK</key>
    <string>medium</string>
    <!-- **Two hours, not the 75 minutes big uses.** This loop's gate is clippy, `cargo nextest run
         --workspace` and `cargo test --workspace --doc` plus `accept.py`; the mapper's 54 per-file test
         binaries were folded into one `--test editor` binary (autotests = false), so the gate rebuilds
         one binary instead of 54. Measured on big's gate.log to 2026-11-03: clippy ~73 s, nextest
         154-181 s, doctests ~110 s. A pass killed at the ceiling after doing the work is pure loss. -->
    <key>WIGGUM_PASS_TIMEOUT</key>
    <string>7200</string>
    <key>RUSTUP_TOOLCHAIN</key>
    <string>1.98.1</string>
    <!-- **Its own target dir, never `~/.cargo-target-shared/global`, and this is a measured trap.**
         Workspace crates at one version share an artifact hash across checkouts, so a second tree using
         the shared dir makes cargo report this one's units Fresh and silently run the other tree's
         code (2026-10-21). Outside the repo for the sibling reason: a loop's bookkeeping must not appear
         in a pass's `git status`. -->
    <key>CARGO_TARGET_DIR</key>
    <string>/Users/USER/target/emerge-loop</string>
    <!-- **A smaller job count than big's 8.** This machine has 10 cores and runs a second loop
         (bevy_elements) whose release builds are heavy; measured load reached 52 while two builds ran
         side by side here. Four leaves room for the other loop and for the captures. -->
    <key>CARGO_BUILD_JOBS</key>
    <string>4</string>
    <key>RUST_BACKTRACE</key>
    <string>1</string>
  </dict>

  <key>ProcessType</key>
  <string>Background</string>

  <!-- Below the interactive user and below nothing else: the second loop is not nicer than this one. -->
  <key>Nice</key>
  <integer>10</integer>

  <!-- **`accept.py` launches the real, windowed editor.** On macOS there is no Xvfb: a Bevy window needs
       a window-server session. This agent runs as the logged-in user of a console session, so it
       inherits one. If this machine ever runs headless (no console login), the editor cannot open a
       window and `accept.py` fails — the loop would then look broken for a reason that is not in the
       code. `caffeinate -i` should wrap long passes so an idle sleep cannot freeze one silently; it is
       applied by the driver's own caller, not here, because `ProgramArguments` is already fixed. -->
  <key>StandardOutPath</key>
  <string>/Users/USER/Library/Logs/wiggum-emerge/out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/USER/Library/Logs/wiggum-emerge/err.log</string>

  <!-- Generous: launchd's SIGKILL comes after this long. The driver exits within seconds of a stop, because it ends the pass in flight. -->
  <key>ExitTimeOut</key>
  <integer>4800</integer>
</dict>
</plist>
