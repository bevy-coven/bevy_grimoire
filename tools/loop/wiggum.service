[Unit]
Description=bevy_emerge_loop Wiggum loop (one fresh build-loop pass at a time)
# **Never spin.** A pass that dies instantly, five times running, is a broken machine or a broken
# checkout, and `Restart=always` alone would retry it forever. Both keys are `[Unit]` keys; systemd
# ignores them in `[Service]` with only a warning, which is how the first version was silently wrong.
StartLimitIntervalSec=3600
StartLimitBurst=5
Documentation=file:%h/bevy_emerge_loop/.omp/commands/build-loop.md
# **Runs forever, so it must not be tied to a login.** `loginctl enable-linger` is already on for this
# user; without it a user unit dies when the last session closes.
After=network-online.target
Wants=network-online.target
# **Nothing else may drive this checkout.** Not a dependency — a guard: if the unit is restarted while
# something else holds the tree, the driver's own single-instance check refuses to start rather than
# racing it. It finds the other driver by a marker **argument** (`__driver wiggum-<user>-<repo>`), which
# is the only place `pgrep -f` looks; measured 2026-10-26, the environment form matched nothing and two
# drivers interleaved their passes in one checkout.

[Service]
Type=simple
WorkingDirectory=%h/bevy_emerge_loop

# **One fresh `omp -p` per pass; the driver sleeps between them.** Not `Type=oneshot` with a timer: a
# pass takes up to 45 minutes and a timer would start a second one on top of it.
# **A display exists for the whole life of the service, because `accept.py` opens the real editor.**
# The editor is a windowed Bevy app (`main.rs` always builds a `Window`), so a pass with no display fails
# its gate every time, and a gate that always fails is a loop that ships nothing.
# `-ac` is safe here: the server listens on no TCP socket (`-nolisten tcp`) and is reachable only from this
# machine's own filesystem socket, which is what a private, unauthenticated scratch display needs.
# `ExecStopPost` reaps it, so a stopped service leaves no X server behind.
# **The pattern must match any Xvfb on :99, not only one this unit started.** Measured on big: I had
# started `Xvfb :99` by hand to test the display, the unit's `pkill -f "... -ac"` did not match it, the
# `test -S /tmp/.X11-unix/X99` then passed on *my* server, and the unit looked healthy while never having
# created a display — so the reboot path was never exercised. Matching on the display number alone is
# what reaps a stale server from an older invocation, which is the reason the kill exists.
ExecStartPre=-/usr/bin/pkill -f "Xvfb :99 "
ExecStartPre=-/bin/sh -c 'sleep 1; rm -f /tmp/.X11-unix/X99' 
ExecStartPre=/bin/sh -c 'sleep 1; /usr/bin/Xvfb :99 -screen 0 1920x1080x24 -nolisten tcp -ac & sleep 2; test -S /tmp/.X11-unix/X99'
ExecStopPost=-/usr/bin/pkill -f "Xvfb :99 "

ExecStart=%h/bevy_emerge_loop/tools/loop/wiggum.sh __driver

Environment=WIGGUM_REPO=%h/bevy_emerge_loop
Environment=WIGGUM_MODEL=claude-sonnet-5-5
Environment=WIGGUM_SLEEP=60
# Every loop repo's command is `.omp/commands/build-loop.md`. `/bevy-loop` is the generic fallback for a repo with none.
Environment=WIGGUM_COMMAND=build-loop
Environment=WIGGUM_THINK=medium
Environment=WIGGUM_MAX=0

# **The toolchain the repo is pinned to.** `rust-toolchain.toml` may not exist yet, and `stable` on this
# machine is 1.99 while the workspace is pinned to 1.98.
# **systemd's default PATH is not a login shell's PATH.** Measured: the first real pass exited `rc=127`
# with `omp: command not found`, because `omp` lives in `~/.local/bin` and `cargo` in `~/.cargo/bin`, and
# neither is on systemd's built-in path. An explicitly composed PATH is the fix; growing it by hand is
# exactly the kind of thing that breaks silently later, so it names the three dirs the loop actually uses.
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin

Environment=RUSTUP_TOOLCHAIN=1.98.1
# **Its own target dir, never `~/.cargo-target-shared/global`.** Workspace crates at one version share
# an artifact hash across checkouts, so a second tree using the shared dir makes cargo report this one's
# units as Fresh and silently run the other tree's code — measured here on 2026-10-21.
Environment=CARGO_TARGET_DIR=%h/target/emerge-loop
# **Under the machine's other work.** big also builds bevy_elements and serves hs-distill; a loop that
# takes every core makes those fail. Measured: load average was 31 on 24 cores with 3 GB RAM free.
Environment=CARGO_BUILD_JOBS=8
Environment=RUST_BACKTRACE=1

# **A private scratch display, not the machine's real X server.** Measured on big: `/tmp/.X11-unix/X0`
# exists, but no `DISPLAY` and no `~/.Xauthority` in a non-graphical session, so :0 is not usable from a
# service. :99 is ours, and the `ExecStartPre` above is what creates it.
Environment=DISPLAY=:99

Nice=15
IOSchedulingClass=idle

# **Stop ends the pass in flight, within seconds; `wiggum.sh drain` does not.** The driver traps SIGTERM and
# writes its stop file, and its poll loop answers a stop file by sending the pass TERM and then KILL five
# seconds later (since `df7324e`); KillMode defaults to control-group, so systemd signals every process in
# the unit as well. What the pass had uncommitted is saved by the final snapshot and parked on a branch at
# the next start. `wiggum.sh drain --wait` is the way to let a pass finish: the driver then exits cleanly,
# which `Restart=always` below turns into a restart onto whatever driver and prompt are installed by then.
# `TimeoutStopSec` only has to cover a slow exit, and a long one turns a leaked process in the cgroup into
# a long stuck stop.
KillSignal=SIGTERM
TimeoutStopSec=300

# **`on-failure`, never `always`** (owner, 2026-11-02). `always` restarts a driver that *chose* to stop,
# so `drain` can never end a loop: measured on big, `wiggum@gooey`'s 80th pass drained at 11:23:04 and
# systemd restarted it at 11:25:07 for pass 81. `wiggum.sh` exits 0 for stop/drain/WIGGUM_MAX and 1 for
# a give-up after five consecutive failed passes (see `docs/loop/RUNNING-A-LOOP.md`), which is exactly
# the distinction `on-failure` acts on.
Restart=on-failure
RestartSec=120

# **Log to the journal, not to a file, and the reason is the failure this unit already had.** An
# `append:` path fails the whole start with `status=209/STDOUT` ("Failed to set up standard output") when
# its directory does not exist, and `LogsDirectory=` did not create it before the output was opened —
# measured on big with systemd 262: `/run/user/1000/wiggum` was still absent while every `ExecStartPre`
# died on it. The journal needs no directory, is where `journalctl --user -u wiggum@emerge` reads, and is
# outside the repository, which is the property that mattered. The driver keeps its own `driver.log` and
# one log per pass under `~/.local/state/wiggum/<repo>/passes/` regardless.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
