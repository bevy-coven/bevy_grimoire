// The editor's own checks. A game adds its own in its project's `checks.ron` (same shape).
// A check asks one yes/no question about what an operation changed; P(yes) at or above `threshold`
// is a finding. `calibration` is None until a labelled set of real captures has earned one, and a
// check without one is advisory: it can never block the loop's gate.
(
    version: 1,
    checks: [
        (
            name: "floating",
            question: "Is any piece in the close-up floating above the ground, with empty space between it and whatever should support it?",
            images: ["closeup"],
            facts: true,
            threshold: 0.70,
            after_edit: true,
            calibration: None,
        ),
        (
            name: "clipping",
            question: "Does any piece in the close-up pass through another piece, so that part of one is hidden inside the other?",
            images: ["closeup"],
            facts: true,
            threshold: 0.70,
            after_edit: true,
            calibration: None,
        ),
        (
            name: "out_of_area",
            question: "Compared with the before image, did anything change outside the area the facts say was selected?",
            images: ["before", "after"],
            facts: true,
            threshold: 0.70,
            after_edit: true,
            calibration: None,
        ),
        (
            name: "blank_frame",
            question: "Is the image blank: a single flat colour, all black, or magenta, with no scene in it?",
            images: ["view"],
            facts: false,
            threshold: 0.70,
            after_edit: false,
            calibration: None,
        ),
        (
            name: "toast_visible",
            question: "Is a toast or problem message visible on the screen?",
            images: ["view"],
            facts: false,
            threshold: 0.70,
            after_edit: true,
            calibration: None,
        ),
    ],
)
